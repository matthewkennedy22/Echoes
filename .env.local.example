# Copy this file to ".env.local" and fill in your key.
# Get an API key at https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-...

# Optional overrides (sensible defaults are used if omitted):
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_EMBED_DIM=512
#
# After changing sources/book chunks, rebuild shipped embeddings before deploy:
#   npm run embed:persona -- <slug>
# See README "Updating sources (ingest → embed → deploy)".

# Voice (text-to-speech) tuning:
# OPENAI_TTS_VOICE=onyx          # try: onyx, ash, echo, sage, fable
# OPENAI_TTS_SPEED=1.12          # 1.0 = normal, higher = faster
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_INSTRUCTIONS=Voice of a very old man, about 78, frail but dignified...

# Image search (Wikimedia Commons, public domain / CC only):
# IMAGE_SEARCH_ENABLED=true
# IMAGE_SEARCH_MAX=4
