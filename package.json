    "ingest": "node scripts/ingest-book.mjs",
    "ingest:persona": "node scripts/ingest-persona-books.mjs",
    "embed:persona": "npx tsx scripts/embed-persona-index.ts",
    "fetch-images": "node scripts/fetch-images.mjs",
