{
  "name": "echoes",
  "version": "0.1.0",
  "private": true,
  "description": "ECHOES — local history, made conversational. Hero persona: Myron Angel (San Luis Obispo).",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
